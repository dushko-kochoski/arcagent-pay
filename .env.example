# Arc network configuration.
# Fill these from the current official Arc documentation.
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_USDC_ADDRESS=

# ArcAgentVault contract address after deployment.
ARC_AGENT_VAULT_ADDRESS=

# Authorised Agent signer.
# NEVER commit a real private key.
AGENT_PRIVATE_KEY=

# AI decision provider.
# "ollama" uses the local Qwen model.
# "development" uses the deterministic development agent.
AGENT_DECISION_PROVIDER=ollama

# Local Ollama configuration.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
